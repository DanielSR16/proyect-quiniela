# Cadena de conexión de Supabase: Project Settings > Database > Connection string
# (usa la del "Session pooler" o "Direct connection"; reemplaza [PASSWORD])
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Cadena larga y aleatoria para firmar las sesiones. Ej: openssl rand -hex 32
JWT_SECRET=cambia-esto

# Origen del frontend (CORS con cookies)
FRONTEND_URL=http://localhost:3000

PORT=4000
